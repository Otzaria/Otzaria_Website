{
  "name": "otzaria-rewrite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-plugin-validator.cjs",
    "dev": "next dev",
    "generate-version": "node -e \"const fs = require('fs'); fs.writeFileSync('./public/version.json', JSON.stringify({ version: Date.now() }));\"",
    "build:offline-editor": "node scripts/build-offline-editor.js",
    "build:icons": "node scripts/build-icon-font.mjs",
    "build:assets": "node scripts/optimize-assets.mjs",
    "refresh:editor-icons": "node scripts/build-offline-editor.js --refresh-icons",
    "check:icons": "node scripts/build-icon-font.mjs --check",
    "check:perf": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-perf-budget.mjs",
    "build": "node scripts/patch-plugin-validator.cjs && npm run generate-version && npm run check:icons && next build && npm run build:offline-editor && npm run check:perf && node scripts/check-production-trace.cjs",
    "start": "next start",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/*.test.mjs src/lib/*/*.test.mjs && vitest run",
    "test:node": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/*.test.mjs src/lib/*/*.test.mjs",
    "test:plugin-safety": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/pluginArchive.test.mjs src/lib/pluginValidationIsolation.test.mjs src/lib/pluginValidatorPatch.test.mjs src/lib/pluginDeploy.test.mjs && vitest run src/app/api/plugins/upload/safety.test.ts",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "test:deployment-regressions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/deploymentRegressions.test.mjs src/lib/pdfConverter.test.mjs && vitest run src/lib/githubReleases.test.js src/lib/db.test.js src/components/home/DownloadSection.test.tsx src/components/offline/OfflineUpdateDownload.test.jsx src/app/api/github-releases/route.test.js src/app/api/offline-update-releases/route.test.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "dompurify": "^3.4.16",
    "dotenv": "^17.2.3",
    "fflate": "^0.8.3",
    "framer-motion": "^12.23.26",
    "fs-extra": "^11.2.0",
    "hermes-parser": "^0.36.1",
    "limiter": "^3.0.0",
    "minisearch": "^7.2.0",
    "mongoose": "^9.1.0",
    "next": "^16.4.0",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.0.16",
    "nspell": "^2.1.5",
    "otzaria-plugin-validator": "github:Otzaria/otzaria-plugin-validator#v1",
    "pdf-lib": "^1.17.1",
    "pdf-to-img": "^7.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-is": "^19.2.5",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "slugify": "^1.6.6",
    "tesseract.js": "^7.0.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "brace-expansion": "^2.1.7",
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-security": "^4.0.0",
    "jsdom": "^30.0.1",
    "mongodb-memory-server-core": "^11.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
