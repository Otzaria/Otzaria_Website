# --- הגדרות מסד נתונים ---
# מכיוון ש-NodeBB כבר משתמש במונגו, אנחנו נתחבר לאותו שירות אבל ניצור DB נפרד.
# אם אתה מריץ ישירות על השרת (בלי דוקר), הכתובת היא localhost.
MONGODB_URI=mongodb://127.0.0.1:27017/otzaria_db

# --- הגדרות אימות (NextAuth) ---
# כתובת האתר שלך (בייצור שנה לדומיין האמיתי)
NEXTAUTH_URL=http://localhost:3000

# מפתח אבטחה להצפנת ה-Sessions.
# אפשר לייצר אחד חדש ע"י הרצת הפקודה בטרמינל: openssl rand -base64 32
NEXTAUTH_SECRET=your_super_secure_random_string_here

# --- הגדרות שירותים חיצוניים ---
# מפתח ה-API של גוגל לשימוש ב-Gemini (עבור OCR)
GEMINI_API_KEY=your_google_gemini_api_key_here

OCRWIN_URL=http://<SERVER_IP>:8000/ocr
OCRWIN_API_KEY=YOUR_API_KEY

# --- הגדרת אבטחה: מנגנון ה-rate-limit (src/lib/client-ip.js) ---
# מספר ה-proxy-ים האמינים שהבקשה עוברת לפני האפליקציה.
#   0 (ברירת המחדל הבטוחה) — האפליקציה חשופה ישירות ללקוחות: משתמשים רק
#      בכתובת ה-peer משכבת ה-socket; headers כמו x-forwarded-for/x-real-ip
#      מתעלמים כליל (הלקוח שולט בהם).
#   1 — מאחורי reverse-proxy יחיד (nginx/Vercel/Cloudflare)
#   2 — מאחורי load-balancer + reverse-proxy, וכן הלאה.
# ⚠️ חובה להגדיר את הערך הנכון לטופולוגיה שלכם; הגדרה שגויה תאפשר
#    עקיפת rate-limit (ערך גבוה מדי) או חסימות-יתר (נמוך מדי).
TRUSTED_PROXY_COUNT=0

# --- הגדרות מערכת ---
# נתיב לשמירת הקבצים.
# בהתקנה ישירה (ללא דוקר), זה נתיב אבסולוטי בשרת או יחסי לתיקיית הפרויקט.
# הקוד מצפה שהתיקייה תהיה בתוך public כדי שהדפדפן יוכל לגשת לתמונות.
UPLOAD_DIR=./public/uploads

# --- הגדרות אדמין ראשוני ---
# משמש את הסקריפט scripts/create-admin.js ליצירת המשתמש הראשון
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=strong_password_123


# --- הגדרות SMTP למשלוח מיילים ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# האם להשתמש בחיבור מאובטח (true לפורט 465, false ל-587)
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
# ב-Gmail יש להשתמש ב-App Password ולא בסיסמה הרגילה
SMTP_PASS=your-app-password
# כתובת השולח שתופיע במייל
SMTP_FROM="Otzaria System <no-reply@otzaria.org>"


# --- מרחב עריכת הספרים הערוכים (Dicta ערוך) ---
# מאיפה מושכים ספרים (קריאה בלבד, ציבורי)
DICTA_LIBRARY_PULL_REPO=Otzaria/otzaria-library
DICTA_LIBRARY_PULL_BRANCH=main
# לאן דוחפים את התיקונים בחזרה. כרגע הפורק של Otzaria.
DICTA_LIBRARY_PUSH_REPO=Otzaria/otzaria-library
DICTA_LIBRARY_PUSH_BRANCH=main
# נתיב הבסיס של הספרים הערוכים בתוך הריפו
DICTA_LIBRARY_BASE_PATH=DictaToOtzaria/ערוך/ספרים/אוצריא
# טוקן GitHub עם הרשאת כתיבה לריפו הדחיפה (נדרש רק לסנכרון/דחיפה — שלב 5).
DICTA_LIBRARY_GITHUB_TOKEN=
# סוד ה-webhook לרענון מדריך המשתמש (/docs) אחרי עריכת הוויקי בגיטהאב.
# אותו ערך מוגדר גם ב-GitHub: Settings → Webhooks → Secret (אירוע Wiki/gollum).
# ללא הגדרה — ה-webhook מנוטרל (503) והדפים מתרעננים לבד כל 30 דקות.
WIKI_REVALIDATE_SECRET=

# --- תיקוני טקסט (docs/text-corrections/OPERATIONS.md) ---
# סוד ה-cron (משותף לכל /api/cron/*, כולל ה-worker של התיקונים)
CRON_SECRET=
# קבלת דיווחים מהתוכנה (ברירת מחדל: פעיל)
CORRECTIONS_INTAKE_ENABLED=1
# שירות הבדיקה החיצוני — כבוי עד שיוגדר במפורש. בלי כתובת/סוד = הכל עובר לתור הידני.
CORRECTIONS_VERIFY_ENABLED=0
CORRECTIONS_VERIFY_URL=
CORRECTIONS_VERIFY_SECRET=
# הסמכות שהאתר מעניק לשירות: none | technical_only | technical_and_content
CORRECTIONS_VERIFY_AUTHORITY=technical_only
# ההיקף שמבקשים מהשירות (לא יותר מהסמכות)
CORRECTIONS_VERIFY_REQUESTED_SCOPE=technical_only
# דחייה אוטומטית של החלטת rejected מהשירות (ברירת מחדל: כבוי — מתנדב מחליט)
CORRECTIONS_VERIFY_AUTO_REJECT=0
# 1 = הכתובת היא שרת דמה. בייצור זה משבית את השירות לגמרי.
CORRECTIONS_VERIFY_MOCK=0
CORRECTIONS_VERIFY_MAX_ATTEMPTS=6
CORRECTIONS_VERIFY_MAX_TOTAL_SECONDS=86400
CORRECTIONS_VERIFY_TIMEOUT_MS=20000
CORRECTIONS_VERIFY_BACKOFF_BASE_SECONDS=30
CORRECTIONS_VERIFY_BACKOFF_CAP_SECONDS=3600
# פרסום אוטומטי אחרי אישור מלא של השירות (ברירת מחדל: כבוי)
CORRECTIONS_AUTO_PUBLISH=0
# מצב הפרסום: disabled | pr | direct  (ריק: pr כשיש טוקן, אחרת disabled)
CORRECTIONS_PUBLISH_MODE=
# יעד הפרסום — חובה במפורש, אין ברירת מחדל. הטוקן: הרשאת contents+pull_requests לריפו זה בלבד.
CORRECTIONS_GITHUB_REPO=
CORRECTIONS_GITHUB_BRANCH=
CORRECTIONS_GITHUB_TOKEN=
# קומיט ישיר דורש גם את זה (ו-CORRECTIONS_PUBLISH_MODE=direct). לא עוקף branch protection.
CORRECTIONS_ALLOW_DIRECT_COMMIT=0
# מקור הקריאה (resolver) — קריאה בלבד
CORRECTIONS_SOURCE_REPO=Otzaria/otzaria-library
CORRECTIONS_SOURCE_REF=main
# טוקן קריאה אופציונלי להגדלת מכסת ה-API (ברירת מחדל: טוקן הפרסום אם הוגדר)
CORRECTIONS_SOURCE_TOKEN=
# מטמון ראש הענף לתצוגת דיווח (שניות). בלי טוקן, GitHub מגביל ל-60 בקשות לשעה לכתובת IP.
CORRECTIONS_SOURCE_HEAD_TTL_SECONDS=30
CORRECTIONS_SOURCE_CACHE_BYTES=67108864
# שורות הקשר לפני ואחרי השורה ב-diff (תצוגת המתנדב ושדה diff בבקשה לשירות), 0-50
CORRECTIONS_DIFF_CONTEXT_LINES=3
# תור ו-worker
CORRECTIONS_WORKER_BATCH=10
CORRECTIONS_WORKER_CONCURRENCY=2
CORRECTIONS_JOB_LEASE_SECONDS=120
CORRECTIONS_HEARTBEAT_STALE_SECONDS=300
CORRECTIONS_CLAIM_MINUTES=120
CORRECTIONS_WORKER_PAUSE_ON_SHABBAT=1
# לולאת scripts/corrections-worker.mjs
CORRECTIONS_WORKER_URL=http://127.0.0.1:3000
CORRECTIONS_WORKER_INTERVAL_SECONDS=30
