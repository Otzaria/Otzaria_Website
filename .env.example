# --- הגדרות מסד נתונים ---
# מכיוון ש-NodeBB כבר משתמש במונגו, אנחנו נתחבר לאותו שירות אבל ניצור DB נפרד.
# אם אתה מריץ ישירות על השרת (בלי דוקר), הכתובת היא localhost.
MONGODB_URI=mongodb://127.0.0.1:27017/otzaria_db

# --- הגדרות אימות (NextAuth) ---
# כתובת האתר שלך (בייצור שנה לדומיין האמיתי)
NEXTAUTH_URL=http://localhost:3000

# מפתח אבטחה להצפנת ה-Sessions.
# אפשר לייצר אחד חדש ע"י הרצת הפקודה בטרמינל: openssl rand -base64 32
NEXTAUTH_SECRET=your_super_secure_random_string_here

# --- הגדרות שירותים חיצוניים ---
# מפתח ה-API של גוגל לשימוש ב-Gemini (עבור OCR)
GEMINI_API_KEY=your_google_gemini_api_key_here

OCRWIN_URL=http://<SERVER_IP>:8000/ocr
OCRWIN_API_KEY=YOUR_API_KEY

# --- הגדרות מערכת ---
# נתיב לשמירת הקבצים.
# בהתקנה ישירה (ללא דוקר), זה נתיב אבסולוטי בשרת או יחסי לתיקיית הפרויקט.
# הקוד מצפה שהתיקייה תהיה בתוך public כדי שהדפדפן יוכל לגשת לתמונות.
UPLOAD_DIR=./public/uploads

# --- הגדרות אדמין ראשוני ---
# משמש את הסקריפט scripts/create-admin.js ליצירת המשתמש הראשון
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=strong_password_123


# --- הגדרות SMTP למשלוח מיילים ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# האם להשתמש בחיבור מאובטח (true לפורט 465, false ל-587)
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
# ב-Gmail יש להשתמש ב-App Password ולא בסיסמה הרגילה
SMTP_PASS=your-app-password
# כתובת השולח שתופיע במייל
SMTP_FROM="Otzaria System <no-reply@otzaria.org>"


# --- מרחב עריכת הספרים הערוכים (Dicta ערוך) ---
# מאיפה מושכים ספרים (קריאה בלבד, ציבורי)
DICTA_LIBRARY_PULL_REPO=Otzaria/otzaria-library
DICTA_LIBRARY_PULL_BRANCH=main
# לאן דוחפים את התיקונים בחזרה. כרגע הפורק של Otzaria.
DICTA_LIBRARY_PUSH_REPO=Otzaria/otzaria-library
DICTA_LIBRARY_PUSH_BRANCH=main
# נתיב הבסיס של הספרים הערוכים בתוך הריפו
DICTA_LIBRARY_BASE_PATH=DictaToOtzaria/ערוך/ספרים/אוצריא
# טוקן GitHub עם הרשאת כתיבה לריפו הדחיפה (נדרש רק לסנכרון/דחיפה — שלב 5).
DICTA_LIBRARY_GITHUB_TOKEN=